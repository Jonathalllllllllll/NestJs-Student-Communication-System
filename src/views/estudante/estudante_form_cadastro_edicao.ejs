<!DOCTYPE html>
<head> 
    <%- include('../partials/head'); %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Produto</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: #fff;
        }

        h2 {
            text-align: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin: 20px 0 40px;
            color: #FFD700;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.6);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            animation: slideIn 1s ease-in-out;
        }

        .form-group label {
            color: #FFD700;
            font-weight: bold;
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.3);
            border: none;
            border-radius: 5px;
            color: #fff;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
        }

        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.5);
            border-color: #FFD700;
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.8);
        }

        button[type="submit"] {
            background-color: #FFD700;
            color: #1e3c72;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 1.2rem;
            transition: background-color 0.3s ease;
        }

        button[type="submit"]:hover {
            background-color: #ffbb33;
        }

        .btn-secondary {
            background-color: #555;
            border: none;
            border-radius: 5px;
            padding: 8px 20px;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #777;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            h2 {
                font-size: 2rem;
            }

            .form-group label,
            .form-control {
                font-size: 1rem;
            }

            button[type="submit"] {
                font-size: 1rem;
            }
        }
    </style>
</head>

<body>
    <header>
        <%- include('../partials/menu'); %>
    </header>

    <div class="container">
        <h2>Houve problemas com sua compra? Reinforme os dados no formulário abaixo.</h2>






        <% info_cadastro_E.forEach(function(info) { %>
            <form action="/estudante/cadastro_edicao_backend/<%= info.id_E%>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="nome_E_edicao">Nome do estudante:</label>
                    <input type="text" class="form-control" name="nome_E_edicao" value="<%= info.nome_E%>" required>
                </div>

                <div class="form-group">
                    <label for="turma_E_edicao">Sua turma</label>
                   <select id ="turma_E_edicao" name="turma_E_edicao" class="turma_E_edicao" value="<%= info.turma_E %>" required>
                       <option class="1t_turma_E_edicao" name="1t_turma_E_edicao">1T</option>
                       <option class="1m_turma_E_edicao" name="1m_turma_E_edicao">1M</option>
                       <option class="2t_turma_E_edicao" name="2t_turma_E_edicao">2T</option>
                       <option class="2m_turma_E_edicao" name="2m_turma_E_edicao">2M</option>
                       <option class="3t_turma_E_edicao" name="3t_turma_E_edicao">3T</option>
                       <option class="3m_turma_E_edicao" name="3m_turma_E_edicao">3M</option>
                       <option class="4t_turma_E_edicao" name="4t_turma_E_edicao">4T</option>
                       <option class="4m_turma_E_edicao" name="4m_turma_E_edicao">4M</option>
                   </select>
                 </div>

                <div class="form-group">
                    <label for="idade_E_edicao">Idade:</label>
                    <input type="number" class="form-control" name="idade_E_edicao" value="<%= info.idade_E %>" required>
                </div>

                
                <div class="form-group">
                    <label for="arquivo">Sua foto atual</label>
                    <% if (info.foto_E) { %>
                        <img src="/imagens/estudante/estudante_cadastro<%= info.foto_E %>" alt="Imagem do estudante" style="max-width: 200px; display: block; margin-bottom: 10px;">
                    <% } %>
                    <input type="text" class="form-control" value="<%= info.foto_E %>" readonly>
                    <input type="hidden" name="arquivo_atual" value="<%= info.foto_E %>">
                    <input type="file" class="form-control" name="foto_E_edicao" id="foto_E_edicao" style="display: none;" onchange="updateFileName()">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('arquivo').click();">
                        Cadastre uma imagem diferente
                    </button>
                </div>

                <script>
                    function updateFileName() {
                        var fileInput = document.getElementById('foto_E');
                        var button = document.querySelector('button[type="button"]');
                        if (fileInput.files.length > 0) {
                            button.textContent = fileInput.files[0].name;
                        }
                    }
                </script>


                <div class="form-group">
                    <label for="senha_E_edicao">Senha:</label>
                    <input type="number" class="form-control" name="senha_E_edicao" value="<%= info.senha_E %>" required>
                </div>



           


                <button type="submit" class="btn btn-primary">Envio de atualização</button>
            </form>
        <% }) %>

        <button><a href="/" class="material-icons">arrow_back</a></button>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
