<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head'); %>

  <meta charset="UTF-8">
  <title>Responder Comentário</title>
  <style>
    body{
      margin: 0;
      padding: 0;
      background-color: #94b6da;
    }
    .body1 {
  width: 70%;      
  margin: 0 auto;  
  align-items: center;     
  height: 80vh; 
   
  display:grid;
}
#t1{
  color:white;
  background-color:  #014aa3;
  height:100px;
  width:600px;
  text-align: center;
  position: relative;
  top: 0; 
  left:20%; 
  z-index: 999;     

  
 
}
    .mensagem {
      display: flex;
      align-items: flex-start;
      margin: 10px 0;
    }
    .mensagem img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      margin-right: 10px;
    }
    .mensagem.estudante {
      flex-direction: row;

    }
    .mensagem.coordenador {
      flex-direction: row-reverse; 
      text-align: right;
    }
    .mensagem .texto {
      max-width: 80%;
      padding: 10px;
      border-radius: 5px;
      background-color: #014aa3;
      color:white;
      font-size: 18px;;
    }
    .mensagem.coordenador .texto {
      background-color: white;
      color: #014aa3;
    }
    #retangulo_a{
      display: flex;         
  justify-content: center;   
  align-items: center;  
      background-color: white;
      width: 100vw;     
      height: 80px;
      text-align: center;
      color:black;
      font-family: Arial black;
      
      position: relative;
      margin-top: 0%;
      margin-left: calc(-50vw + 50%);
    }
   
  </style>
</head>
<body>
  <header><%- include('../partials/menu'); %></header>

 
<div class="body1">
  <h1 id="t1">FÓRUM DE CONVERSA COM COORDENADOR(A) </h1> 

  <div id="retangulo_a">

    <% if (comentario.resposta_adm) { %>


    <h2>Conversa com coordenador <%= comentario.nome_adm %></h2>
    <% } else { %>
      <h2>Aguarde o coordenador responder</h2>
    <% } %>

  </div>
  


  <div class="mensagem estudante">
    <img class="im_e" src="/imagens/estudante/estudante_cadastro/<%= userImage %>" alt="Foto Estudante">
    <div class="texto">
      <p><strong>Você:</strong> <%= comentario.comentario_E || 'Sem descrição' %></p>
      <span>
        <%= new Date(comentario.data_comentario_E).toLocaleString('pt-BR', { dateStyle: 'short' , timeStyle: 'short'
          }) %>
      </span>    </div>
  </div>

  <% if (comentario.resposta_adm) { %>
    <div class="mensagem coordenador">
      <img class="im_c" src="/imagens/administrador/adm_cadastro/<%= userImage_adm %>" alt="Foto Coordenador">
      <div class="texto">
        <p><strong><%= comentario.nome_adm %>:</strong> <%= comentario.resposta_adm %></p>
        <span>
          <%= new Date(comentario.data_resposta_adm).toLocaleString('pt-BR', { dateStyle: 'short' , timeStyle: 'short'
            }) %>
        </span>  
      </div>
    </div>
  <% } else { %>
    <p><em>Aguarde o coordenador responder</em></p>
  <% } %>

  <hr>

</div>
  
</body>
</html>
