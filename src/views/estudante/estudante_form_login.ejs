<!DOCTYPE html>
<html lang="pt-br">

<head>
   <%- include('../partials/head'); %>
   <style>
      body {
         font-family: 'Poppins', sans-serif;
         margin: 0;
         padding: 0;
         background-color: #91b4d7;
         min-height: 100vh;
         display: flex;
   flex-direction: column; 
      }

      #formulario-login {
         background-color: white;
         border-radius: 10px;
         padding: 40px;
         width: 400px;
         box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
         
      }
      main{
        flex: 1;
         display: flex;
         justify-content: center; 
         align-items: center;   
      }

      h1 {
         color: #1d4ca3;
         font-size: 26px;
         font-weight: 700;
         text-align: center;
         margin-bottom: 30px;
      }

      .form-group {
         display: flex;
         flex-direction: column;
         margin-bottom: 20px;
      }

      label {
         font-weight: bold;
         margin-bottom: 5px;
         color: #000;
      }

      input.form-control {
         border: 3px solid #1d4ca3;
         border-radius: 30px;
         padding: 10px 15px;
         font-size: 16px;
         outline: none;
      }

      button {
         width: 100%;
         background-color: #0047b3;
         color: white;
         font-weight: bold;
         font-size: 20px;
         padding: 12px;
         border: none;
         border-radius: 25px;
         box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
         transition: all 0.3s ease-in-out;
      }

      button:hover {
         background-color: #00398c;
         transform: scale(1.05);
      }

      a {
         display: block;
         text-align: center;
         margin-top: 15px;
         color: #0047b3;
         font-weight: bold;
         text-decoration: none;
      }

      a:hover {
         color: #002a70;
      }

      @media screen and (max-width: 600px) {
         #formulario-login {
            width: 90%;
            padding: 20px;
         }

         h1 {
            font-size: 22px;
         }
      }
   </style>
</head>

<body>
   <header id="menu" style="position: relative;"><%- include('../partials/menu'); %></header>



<main>

   <div id="formulario-login">
      <h1>Login de Usuário</h1>
      <form action="/estudante/login/backend" method="POST">
         <div class="form-group">
            <label for="email_E">Email</label>
            <input type="email" class="form-control" id="email_E" name="email_E" placeholder="Digite seu email" required>
         </div>
         <div class="form-group">
            <label for="senha_E">Senha</label>
            <input type="password" class="form-control" id="senha_E" name="senha_E" placeholder="Digite sua senha" required>
         </div>
         <button type="submit">Login</button>
      </form>
      <a href="/estudante/cadastro/front_end">Não possuo cadastro</a>
   </div>

</main>

</body>

</html>
