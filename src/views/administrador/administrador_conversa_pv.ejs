<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head'); %>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #94b6da; 
      font-family: Arial, sans-serif;
      
    }

    header {
      width: 100%;
    }

    .container-forum {
      width: 70%;
      display: grid;
      align-items: center;
      padding-top: 150px; 
      margin: 0 auto; 
    }

    #forum-title {
      color: white;
      background-color: #014aa3;
      width: 600px;
      height: 150px;
      text-align: center;
      line-height: 150px;
      font-size: 28px;
      font-weight: bold;
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      z-index: 999;
      border-radius: 10px;
    }

    #retangulo-info {
      background-color: white;
      width: 100%;
      max-width: 1000px;
      height: 80px;
      text-align: center;
      line-height: 80px;
      font-family: Arial Black;
      font-size: 30px;
      color: black;
      margin-top: 20px;
      border-radius: 10px;
    }

    .mensagem {
      display: flex;
      align-items: flex-start;
      margin: 20px 0;
      max-width: 1000px;
    }

    .mensagem img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 10px;
    }

    .mensagem.estudante {
      flex-direction: row;
      position: relative;

    }

    .mensagem.coordenador {
      flex-direction: row-reverse;
      text-align: right;
      position: relative;
    }

    .mensagem .texto {
      max-width: 80%;
      padding: 15px;
      border-radius: 10px;
      background-color: #014aa3;
      color: white;
      font-size: 18px;
      word-wrap: break-word;
    }

    .mensagem.coordenador .texto {
      background-color: white;
      color: #4e66f0;
    }

    textarea {
      width: 100%;
      max-width: 1000px;
      padding: 10px;
      font-size: 16px;
      border-radius: 10px;
      border: 1px solid #ccc;
      margin-top: 10px;
    }

    button.submit-btn {
      margin-top: 10px;
      padding: 10px 20px;
      background-color: #014aa3;
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 18px;
      cursor: pointer;
    }

    button.submit-btn:hover {
      background-color: #003b82;
    }

    hr {
      width: 100%;
      max-width: 1000px;
      border: 1px solid #ccc;
      margin: 30px 0;
    }

  </style>
</head>
<body>
  <header><%- include('../partials/menu_adm'); %></header>

  <div class="container-forum">
    <h1 id="forum-title">Fórum de conversa com estudante</h1>

    <div id="retangulo-info">
        Conversa com estudante <%= comentario.nome_E %>
    </div>

    <div class="mensagem estudante">
      <img src="/imagens/estudante/estudante_cadastro/<%= comentario.foto_E %>" alt="Foto do Estudante">
      <div class="texto">
        <p><strong><%= comentario.nome_E %>:</strong> <%= comentario.comentario_E || 'Sem descrição' %></p>
        <span><%= new Date(comentario.data_comentario_E).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %></span>
      </div>
    </div>

    <% if (comentario.resposta_adm) { %>
      <div class="mensagem coordenador">
        <img src="/imagens/administrador/adm_cadastro/<%= comentario.foto_adm %>" alt="Foto do Administrador">
        <div class="texto">
          <p><strong>Você:</strong> <%= comentario.resposta_adm %></p>
          <span><%= new Date(comentario.data_resposta_adm).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %></span>
        </div>
      </div>
    <% } else { %>
      <form method="POST" action="/adm/forum/back_end" enctype="multipart/form-data">
        <input type="hidden" name="id_comentario_E" value="<%= comentario.id_comentario_E %>">
        <input type="hidden" name="data_resposta_adm" value="<%= comentario.data_resposta_adm %>">
        <textarea name="resposta_adm" rows="5" placeholder="Digite sua resposta..."></textarea>
        <button type="submit" class="submit-btn">Enviar resposta</button>
      </form>
    <% } %>

    <hr>
  </div>
</body>
</html>
